# ============================================================
# OOBE Autonomous Agent — Environment Configuration
# ============================================================

# --- Solana / OOBE ---
# Your Solana wallet private key (base58 format) for on-chain SAP interactions
SOLANA_PRIVATE_KEY=your_solana_private_key_here

# OOBE Protocol API key (get from https://oobeprotocol.ai)
OOBE_API_KEY=your_oobe_api_key_here

# Solana RPC endpoint (use OOBE Synapse RPC or public)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- AceDataCloud ---
# Platform token from https://platform.acedata.cloud/console/platform-tokens
ACE_PLATFORM_TOKEN=platform-v1-your_token_here

# AceDataCloud API key (for AI services)
ACE_API_KEY=your_ace_api_key_here

# --- x402 Payment (EVM / Base network) ---
# EVM wallet private key with 0x prefix — must hold USDC on Base mainnet
ACE_X402_PRIVATE_KEY=0xyour_evm_private_key_here

# AceDataCloud Order ID to pay (from https://platform.acedata.cloud/console/orders)
ACE_X402_ORDER_ID=your_order_id_here

# --- AI Provider (for agent reasoning) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Agent Configuration ---
# Task the agent should execute (can be overridden at runtime)
AGENT_TASK=Search for the latest Solana DeFi news and summarize the top 3 stories

# Log level: debug | info | warn | error
LOG_LEVEL=info
